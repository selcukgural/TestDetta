<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Loaded into the test host next to the instrumented assemblies, so it targets the oldest runtime
    we support and depends on nothing that is not already there.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test host provides this assembly at run time; only compile against it. -->
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TestDetta.Tests" />
  </ItemGroup>

</Project>
