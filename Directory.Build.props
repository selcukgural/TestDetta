<Project>
  <!--
    Single place for build settings. Project files only declare what is specific to them
    (output type, project references, packages nobody else needs). Package versions live in
    Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!-- Analyzers: the recommended rule set plus .editorconfig style rules, violations fail the build. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Every public member needs an XML comment (CS1591 becomes an error through TreatWarningsAsErrors). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Restore exactly what the lock file says, so CI and local builds see the same packages. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!--
    Strong names, for the tracker above all: recording adds calls to it into the output's assemblies, and .NET
    Framework refuses to load a strong-named assembly (Newtonsoft.Json, EntityFramework, a package's facade) that
    references one without a strong name, so no test ran. Its friends must be signed for InternalsVisibleTo, and a
    signed assembly references only signed ones, so every project is signed. The key is public on purpose: a strong
    name is an identity, not a security boundary. The SDK adds $(PublicKey) to every InternalsVisibleTo.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)TestDetta.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
  </PropertyGroup>

  <PropertyGroup>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>

  <!-- Test projects: packages and usings come from here, test names document the behaviour. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
