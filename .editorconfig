# Code style for Sift. Rider/ReSharper and the .NET analyzers both read this file.
# Style rules marked ":error" fail the build (EnforceCodeStyleInBuild is on).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Layout ---
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Braces are required, even around a single-line if/else/for/foreach/while body.
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# --- Latest language features ---
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_style_prefer_primary_constructors = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_throw_expression = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_utf8_string_literals = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_conditional_expression_over_return = false
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_readonly_struct = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# Unused code
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_unused_value_discard_variable_preference = true:silent
dotnet_code_quality_unused_parameters = all:warning

# --- Naming (Rider/ReSharper defaults) ---
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error

dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal
dotnet_naming_rule.private_constants_pascal.severity = error

dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal
dotnet_naming_rule.private_static_readonly_pascal.severity = error

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = i_prefix
dotnet_naming_rule.interfaces_i_prefix.severity = error

# Order matters: the specific rules above must win over the generic private-field rule.
dotnet_naming_rule.private_static_readonly_pascal.priority = 1
dotnet_naming_rule.private_constants_pascal.priority = 1
dotnet_naming_rule.private_fields_underscore.priority = 2

# --- Performance ---
# Structured, allocation-free logging via [LoggerMessage] source generation.
dotnet_diagnostic.CA1848.severity = error
dotnet_diagnostic.CA1873.severity = warning
# Prefer span/char overloads and avoid needless allocations.
dotnet_diagnostic.CA1845.severity = warning
dotnet_diagnostic.CA1846.severity = warning
dotnet_diagnostic.CA1847.severity = warning
dotnet_diagnostic.CA1865.severity = warning
dotnet_diagnostic.CA1866.severity = warning
dotnet_diagnostic.CA1827.severity = warning
dotnet_diagnostic.CA1829.severity = warning
dotnet_diagnostic.CA1851.severity = warning
dotnet_diagnostic.CA1859.severity = warning
dotnet_diagnostic.CA1860.severity = warning
dotnet_diagnostic.CA1861.severity = warning
dotnet_diagnostic.CA1862.severity = warning
dotnet_diagnostic.CA1869.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1852.severity = warning

# A CLI tool is not localized; culture-sensitive formatting rules only add noise here.
dotnet_diagnostic.CA1303.severity = none
