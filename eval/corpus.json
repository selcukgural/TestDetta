// Repositories testdetta-eval measures TestDetta on: testdetta-eval --corpus eval/corpus.json --out <dir>.
// Tags say what a repository exercises; the summary reports results per tag. Keep each entry's
// settings next to it: what it needs to build and test on a plain macOS/Linux machine.
{
  "defaults": {
    "framework": "net10.0",
    "parallel": 4,
    // Mutants run at once, each in its own clone copy; measured identical to one at a time (docs/design/mutant-schemata.md).
    "mutantParallelism": 4,
    "synthetic": 100,
    "merges": 0,
    // Every kind from round 2 on: throws alone missed changes that keep a member running (docs/evaluation.md).
    "mutantKinds": "all",
    // Installed under --toolchains from archives pinned in toolchains.lock.json (docs/design/hermetic-toolchains.md).
    "toolchain": { "sdk": "10.0.401", "runtimes": ["8.0.31"] },
    // Builds and tests run under en-US whatever the machine's locale: on a Turkish locale Markdig
    // regenerates its spec classes with culture-dependent names and two protobuf-net tests fail.
    // An entry's own environment adds to this one.
    "environment": { "LC_ALL": "en_US.UTF-8", "LANG": "en_US.UTF-8" }
  },
  "repositories": [
    {
      "name": "roslynator",
      "url": "https://github.com/dotnet/roslynator.git",
      "commit": "3f8fe64a493383fb060c0c355f1f7f2381c5a56f",
