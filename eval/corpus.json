      "setup": "perl -0pi -e 's/\\[Fact\\](\\s+public void LogEvent_OutOfMemoryException_AsyncNotCrash)/[Fact(Skip = \"kills the test host on macOS\")]$1/' tests/NLog.UnitTests/Targets/TargetTests.cs && git update-index --assume-unchanged tests/NLog.UnitTests/Targets/TargetTests.cs",
