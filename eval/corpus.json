      "branch": "master",
      "tags": [
        "serialization",
        "reflection",
        "dynamic-code",
        "static-state",
        "large",
        "multi-target"
      ],
      "notes": "static contract-resolver caches; netfx TFMs are skipped by -f net10.0"
    },
    {
      "name": "protobuf-net",
      "url": "https://github.com/protobuf-net/protobuf-net.git",
      "framework": "net8.0",
      "setup": "dotnet tool restore",
      // DepthTests recurse deeply; macOS gives secondary threads a small stack, so the host overflowed
      // (exit 134) before any test reported. 0x1000000 = 16 MB.
      "environment": { "DOTNET_DefaultStackSize": "1000000" },
      "tags": [
        "serialization",
        "dynamic-code",
        "reflection",
        "static-state",
        "xunit-v3",
        "mtp",
        "large"
      ],
      "notes": "Reflection.Emit serializers; assorted/ WCF projects are Windows-only"
    },
    {
      "name": "yamldotnet",
      "url": "https://github.com/aaubry/YamlDotNet.git",
      "branch": "master",
