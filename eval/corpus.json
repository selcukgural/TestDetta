// Repositories sift-eval measures Sift on: sift-eval --corpus eval/corpus.json --out <dir>.
// Tags say what a repository exercises; the summary reports results per tag. Keep each entry's
// settings next to it: what it needs to build and test on a plain macOS/Linux machine.
{
  "defaults": {
    "framework": "net10.0",
    "parallel": 4,
    // Mutants run at once, each in its own clone copy; measured identical to one at a time (docs/design/mutant-schemata.md).
    "mutantParallelism": 4,
    "synthetic": 100,
    "merges": 0,
    // Installed under --toolchains from archives pinned in toolchains.lock.json (docs/design/hermetic-toolchains.md).
    "toolchain": { "sdk": "10.0.401", "runtimes": ["8.0.31"] }
  },
  "repositories": [
    {
      "name": "roslynator",
      "url": "https://github.com/dotnet/roslynator.git",
      "tags": [
        "analyzers",
        "large",
        "xunit"
      ],
      "notes": "48 projects, AssemblyName built from a property prefix"
    },
    {
      "name": "polly",
      "url": "https://github.com/App-vNext/Polly.git",
      "tags": [
        "mtp",
        "xunit-v3",
        "async",
        "packages"
      ],
      "notes": "test packages come from eng/$(ProjectType).targets; runs Microsoft code coverage in every test run"
    },
    {
      "name": "nodatime",
      "url": "https://github.com/nodatime/nodatime.git",
      "tags": [
        "nunit",
        "conditional-compilation",
        "large-suite"
      ],
      "notes": "about 26,000 tests, heavy use of #if"
    },
    {
      "name": "mapperly",
      "url": "https://github.com/riok/mapperly.git",
      "tags": [
        "source-generator",
        "xunit-v3",
        "snapshots"
      ],
      "notes": "the generator runs in most tests; Verify snapshots"
    },
    {
      "name": "spectre",
      "url": "https://github.com/spectreconsole/spectre.console.git",
      "tags": [
        "xunit",
        "snapshots",
        "polyfill"
      ]
    },
    {
      "name": "communitytoolkit",
      "url": "https://github.com/CommunityToolkit/dotnet.git",
      "tags": [
        "mstest",
        "source-generator",
        "analyzers",
        "conditional-compilation",
        "multi-target"
      ],
      "notes": "whole analyzer files inside #if ROSLYN_*; AssemblyName from a property function"
    },
    {
      "name": "argu",
      "url": "https://github.com/fsprojects/Argu.git",
      "tags": [
        "fsharp"
      ],
      "synthetic": 0,
      "merges": 6,
      "notes": "F# is not analysed; history only"
    },
    {
      "name": "automapper",
      "url": "https://github.com/LuckyPennySoftware/AutoMapper.git",
      "tags": [
        "reflection",
        "dynamic-code",
        "static-state",
        "multi-target"
      ],
      "exclude": [
        "src/IntegrationTests/AutoMapper.IntegrationTests.csproj"
      ],
      "notes": "expression-compiled maps, assembly scanning in DI.Tests; UnitTests also net471; IntegrationTests need SQL Server"
    },
    {
      "name": "autofixture",
      "url": "https://github.com/AutoFixture/AutoFixture.git",
      "branch": "release/5.0.0",
      "tags": [
        "reflection",
        "dynamic-code",
        "xunit-v3",
        "multi-target"
      ],
      "notes": "reflection-driven object creation; 11 test projects incl. AutoMoq/AutoNSubstitute"
    },
    {
      "name": "fluentvalidation",
      "url": "https://github.com/FluentValidation/FluentValidation.git",
      "tags": [
        "reflection",
        "non-code-inputs",
        "small",
        "multi-target"
      ],
      "notes": "validator discovery; test .resx and language files"
    },
    {
      "name": "awesomeassertions",
